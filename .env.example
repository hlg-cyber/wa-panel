# Database (dari Neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (generate random string panjang)
SECRET_KEY=ubah-ini-jadi-random-string-panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Enkripsi token Meta (32-byte base64)
ENCRYPTION_KEY=generate-dengan-perintah-dibawah

# WhatsApp Webhook
VERIFY_TOKEN=bebas-isi-apa-saja-anda-suka

# Super Admin pertama (seed)
SUPERADMIN_EMAIL=admin@panel.com
SUPERADMIN_PASSWORD=ubahpasswordkuat